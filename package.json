    "react-helmet-async": "^1.0.7",
    "react-i18next": "^11.8.5",
    "react-imask": "^6.0.7",
    "react-markdown": "^5.0.3",
    "react-perfect-scrollbar": "^1.5.8",
    "react-redux": "^7.2.2",
    "react-router": "^6.3.0",
