    "bignumber.js": "^9.0.1",
    "bodybuilder": "^2.4.0",
    "clsx": "^1.1.1",
    "date-fns": "^2.24.0",
    "ethers": "^5.7.1",
    "formik": "^2.2.6",
    "gray-matter": "^4.0.2",
    "history": "^5.0.0",
    "html2canvas": "^1.0.0-rc.7",
    "i18next": "^21.8.16",
    "i18next-parser": "^6.5.0",
    "lodash": "^4.17.20",
    "md5": "^2.3.0",
    "moment": "^2.29.4",
    "notistack": "1.0.6-alpha.0",
