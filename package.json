{
  "name": "@eulertools/euler-explorer",
  "author": "Euler Tools",
  "version": "0.0.2",
  "private": true,
  "scripts": {
    "lint": "eslint ./src",
    "lint-fix": "eslint --fix ./src",
    "start": "react-app-rewired start",
    "build": "react-app-rewired build",
    "test": "react-app-rewired test --watchAll=false --passWithNoTests",
    "test:dev": "react-app-rewired test",
    "test:lint": "eslint \"src/**/*.{js,jsx,ts,tsx}\"",
    "test:prettier": "prettier --check \"{src,test}/**/*.{js,jsx,ts,tsx}\" \"*.{js,json}\"",
    "test:all": "npm run test:prettier && npm run test:lint && npm test",
    "translate": "i18next 'src/**/*.{ts,tsx}' '!src/**/*/charting_library' -c ./i18next-parser.config.js",
    "prettier:format": "prettier --write --ignore-unknown \"{src,test}/**/*.{js,jsx,ts,tsx}\" \"*.{js,json}\"",
    "commit:check": "yarn commitlint --edit $1",
    "prepare": "husky install",
    "clear:branches": "git branch | grep -v 'main\\|development\\|beta' | xargs git branch -D"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": ">=12.22.1",
    "npm": ">=6.14.12"
  },
  "dependencies": {
    "@date-io/date-fns": "^2.11.0",
    "@emotion/cache": "^11.1.3",
    "@emotion/react": "^11.1.5",
    "@emotion/styled": "^11.1.5",
